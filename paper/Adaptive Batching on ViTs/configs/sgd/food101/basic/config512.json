{
  "dataset": "food101",
  "batch_size": 512,
  "epochs": 25,
  "optimizer": "sgd",
  "lr": 0.005,
  "weight_decay": 5e-3,
  "scheduler": "cosine",
  "scheduler_T_max": 25,
  "scheduler_eta_min": 1e-4,
  "augment": true,
  "image_size": 224,
  "adaptive_batch": false,
  "adaptive_batch_beta": 0.0,
  "adaptive_batch_min": 8,
  "adaptive_batch_max": 4096,
  "batch_size_multiplier": 1.0,
  "epoch_start_ab": 1,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.1,
  "lora_target_modules": [
    "qkv"
  ],
  "pretrained": true,
  "model_path": "models/faster_vit_0.pth.tar",
  "mlflow_experiment": "ViT Food101 Basic 512",
  "report_to": "mlflow"
}

