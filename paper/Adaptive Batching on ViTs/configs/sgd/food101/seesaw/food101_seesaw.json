{
  "dataset": "food101",
  "batch_size": 16,
  "epochs": 15,
  "optimizer": "sgd",
  "lr": 0.0003,
  "weight_decay": 0.05,
  "scheduler": "cosine",
  "scheduler_T_max": 15,
  "scheduler_eta_min": 1e-06,
  "augment": true,
  "image_size": 224,
  "adaptive_batch": true,
  "adaptive_batch_strategy": "seesaw",
  "seesaw_alpha": 2.0,
  "adaptive_batch_min": 8,
  "adaptive_batch_max": 256,
  "batch_size_multiplier": 1.0,
  "epoch_start_ab": 1,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.1,
  "lora_target_modules": [
    "qkv"
  ],
  "pretrained": true,
  "model_path": "models/faster_vit_0.pth.tar",
  "mlflow_experiment": "ViT LoRA Food101 Seesaw",
  "report_to": "mlflow"
}
