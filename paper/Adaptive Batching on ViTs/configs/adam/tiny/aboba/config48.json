  "adaptive_batch": true,
  "adaptive_batch_strategy": "variance_ratio",
  "adaptive_batch_beta": 0,
  "adaptive_batch_min": 10,
  "adaptive_batch_max": 4096,
  "batch_size_multiplier": 48.0,
  "epoch_start_ab": 2,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.1,
  "lora_target_modules": [
    "qkv"
  ],
  "pretrained": true,
  "model_path": "models/faster_vit_0.pth.tar",
  "mlflow_experiment": "ViT TinyImageNet AdamW Aboba 48",
  "report_to": "mlflow"
}