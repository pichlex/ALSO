{
  "dataset": "tiny_imagenet",
  "batch_size": 64,
  "epochs": 25,
  "optimizer": "sgd",
  "lr": 0.0005,
  "weight_decay": 0.05,
  "scheduler": "cosine",
  "scheduler_T_max": 25,
  "scheduler_eta_min": 5e-06,
  "augment": true,
  "image_size": 224,
  "adaptive_batch": false,
  "adaptive_batch_beta": 0.1,
  "adaptive_batch_min": 16,
  "adaptive_batch_max": 512,
  "batch_size_multiplier": 1.0,
  "epoch_start_ab": 1,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.1,
  "lora_target_modules": [
    "qkv"
  ],
  "mlflow_experiment": "ViT LoRA TinyImageNet Basic",
  "report_to": "mlflow"
}
