{
  "dataset": "food101",
  "epochs": 40,
  "optimizer": "adamw",
  "lr": 0.001,
  "weight_decay": 0.005,
  "scheduler": "cosine",
  "scheduler_T_max": 40,
  "scheduler_eta_min": 1e-05,
  "augment": true,
  "image_size": 224,
  "adaptive_batch_min": 10,
  "adaptive_batch_max": 4096,
  "adaptive_batch_beta": 0.0,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.1,
  "lora_target_modules": [
    "qkv"
  ],
  "pretrained": true,
  "model_path": "models/faster_vit_0.pth.tar",
  "report_to": "mlflow",
  "batch_size": 128,
  "seed": 2,
  "mlflow_experiment": "adamw-food101-seesaw-prcd-bs128-seed2",
  "adaptive_batch": true,
  "adaptive_batch_strategy": "seesaw",
  "seesaw_alpha": 3.0,
  "batch_size_multiplier": 1.0,
  "epoch_start_ab": 2
}
