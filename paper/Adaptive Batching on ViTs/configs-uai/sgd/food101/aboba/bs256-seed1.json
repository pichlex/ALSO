{
  "dataset": "food101",
  "epochs": 25,
  "optimizer": "sgd",
  "lr": 0.005,
  "weight_decay": 0.005,
  "scheduler": "cosine",
  "scheduler_T_max": 25,
  "scheduler_eta_min": 0.001,
  "augment": true,
  "image_size": 224,
  "adaptive_batch_min": 8,
  "adaptive_batch_max": 4096,
  "adaptive_batch_beta": 0.0,
  "lora_r": 8,
  "lora_alpha": 16,
  "lora_dropout": 0.1,
  "lora_target_modules": [
    "qkv"
  ],
  "pretrained": true,
  "model_path": "paper/Adaptive Batching on ViTs/models/faster_vit_0.pth.tar",
  "report_to": "mlflow",
  "batch_size": 256,
  "seed": 1,
  "mlflow_experiment": "sgd-food101-aboba-bs256-seed1",
  "adaptive_batch": true,
  "adaptive_batch_strategy": "variance_ratio",
  "batch_size_multiplier": 2.0,
  "epoch_start_ab": 2
}
