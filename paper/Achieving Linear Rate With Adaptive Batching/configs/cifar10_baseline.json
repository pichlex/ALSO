{
  "dataset": "cifar10",
  "model": "resnet18",
  "seed": 18,
  "augment": false,
  "batch_size": 64,
  "epochs": 20,
  "optimizer": "sgd",
  "lr": 0.1,
  "momentum": 0.9,
  "nesterov": true,
  "weight_decay": 0.0005,
  "adaptive_batch": false,
  "mlflow_experiment": "Achieving Linear - SGD baseline",
  "report_to": "mlflow",
  "tune_runs": 100,
  "n_epoches_tune": 5,
  "tune_name": "cifar10_sgd",
  "use_old_tune_params": true
}
