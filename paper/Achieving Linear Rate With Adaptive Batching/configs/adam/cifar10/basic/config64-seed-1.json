{
  "dataset": "cifar10",
  "model": "resnet18",
  "seed": 1,
  "augment": true,
  "batch_size": 64,
  "epochs": 40,
  "optimizer": "adamw",
  "lr":  0.001,
  "weight_decay":  5e-3,
  "scheduler": "cosine",
  "scheduler_T_max": 40,
  "scheduler_eta_min": 1e-5,
  "adaptive_batch": false,
  "mlflow_experiment": "AdamW base bs 64",
  "report_to": "mlflow",
  "use_old_tune_params": false
}
