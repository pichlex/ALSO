{
  "dataset": "cifar10",
  "model": "resnet18",
  "seed": 2,
  "augment": true,
  "batch_size": 64,
  "epochs": 40,
  "optimizer": "adamw",
  "lr": 0.001,
  "weight_decay": 5e-3,
  "scheduler": "cosine",
  "scheduler_T_max": 40,
  "scheduler_eta_min": 1e-5,
  "adaptive_batch": true,
  "adaptive_batch_strategy": "seesaw",
  "seesaw_alpha": 2.0,
  "adaptive_batch_min": 10,
  "adaptive_batch_max": 4096,
  "batch_size_multiplier": 1.0,
  "epoch_start_ab": 2,
  "mlflow_experiment": "AdamW seesaw",
  "report_to": "mlflow",
  "tune_name": "cifar10_sgd",
  "use_old_tune_params": false
}

