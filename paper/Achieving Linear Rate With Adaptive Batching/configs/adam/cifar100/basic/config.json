{
  "dataset": "cifar100",
  "model": "resnet34",
  "seed": 18,
  "augment": true,
  "batch_size": 128,
  "epochs": 40,
  "optimizer": "adamw",
  "lr":  0.0005,
  "weight_decay":  5e-4,
  "scheduler": "cosine",
  "scheduler_T_max": 40,
  "scheduler_eta_min": 1e-5,
  "adaptive_batch": false,
  "mlflow_experiment": "AdamW CIFAR100 basic",
  "report_to": "mlflow",
  "use_old_tune_params": false
}
