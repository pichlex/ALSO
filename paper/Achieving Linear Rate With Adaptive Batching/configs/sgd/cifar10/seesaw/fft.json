{
  "dataset": "cifar10",
  "model": "resnet18",
  "seed": 0,
  "augment": true,
  "batch_size": 64,
  "epochs": 200,
  "optimizer": "sgd",
  "lr": 0.05,
  "momentum": 0.9,
  "weight_decay": 5e-4,
  "scheduler": "cosine",
  "scheduler_T_max": 200,
  "scheduler_eta_min": 1e-4,
  "adaptive_batch": true,
  "adaptive_batch_strategy": "seesaw",
  "seesaw_alpha": 3.0,
  "adaptive_batch_min": 10,
  "adaptive_batch_max": 8192,
  "mlflow_experiment": "SGD SEESAW FFT",
  "report_to": "mlflow",
  "tune_runs": 100,
  "n_epoches_tune": 10,
  "tune_name": "cifar10_sgd",
  "use_old_tune_params": false
}
