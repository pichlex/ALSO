{
  "dataset": "cifar10",
  "model": "resnet18",
  "seed": 18,
  "augment": true,
  "batch_size": 64,
  "epochs": 40,
  "optimizer": "adabatchgrad",
  "momentum": 0.75,
  "weight_decay": 5e-3,
  "scheduler": "cosine",
  "scheduler_T_max": 40,
  "scheduler_eta_min": 5e-5,
  "adaptive_batch": true,
  "adaptive_batch_strategy": "adabatchgrad",
  "adaptive_batch_beta": 0,
  "adaptive_batch_min": 10,
  "adaptive_batch_max": 1024,
  "batch_size_multiplier": 1.0,
  "epoch_start_ab": 2,
  "adabatchgrad_batch_test": "inner_ortho_nn",
  "adabatchgrad_theta": 0.9,
  "adabatchgrad_nu": 5.84,
  "adabatchgrad_prob_new": 0.005,
  "adabatchgrad_k": 5,
  "adabatchgrad_alpha": 0.1,
  "adabatchgrad_beta": 1.0,
  "adabatchgrad_power_eps": 0.0,
  "mlflow_experiment": "SGD adabatchgrad bs 64",
  "report_to": "mlflow",
  "tune_runs": 100,
  "n_epoches_tune": 10,
  "tune_name": "cifar10_sgd",
  "use_old_tune_params": false
}
