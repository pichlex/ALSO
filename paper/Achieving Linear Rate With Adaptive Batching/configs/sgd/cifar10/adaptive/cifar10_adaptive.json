  "scheduler_gamma": 0.1,
  "adaptive_batch": true,
  "adaptive_batch_beta": 0,
  "adaptive_batch_min": 10,
  "adaptive_batch_max": 65536,
  "epoch_start_ab": 2,
  "mlflow_experiment": "SGD adaptive bs 64",
  "report_to": "mlflow",
  "tune_runs": 100,
  "n_epoches_tune": 10,
  "tune_name": "cifar10_sgd",
  "use_old_tune_params": false
}
