{
  "dataset": "cifar10",
  "model": "resnet18",
  "seed": 18,
  "augment": true,
  "batch_size": 64,
  "epochs": 40,
  "optimizer": "sgd",
  "lr": 0.005,
  "momentum": 0.75,
  "weight_decay": 5e-3,
  "scheduler": "multistep",
  "scheduler_milestones": [5, 10, 15, 20, 25, 30, 35],
  "scheduler_gamma": 0.75,
  "adaptive_batch": true,
  "adaptive_batch_strategy": "divebatch",
  "adaptive_batch_min": 10,
  "adaptive_batch_max": 2048,
  "epoch_start_ab": 0,
  "divebatch_delta": 0.1,
  "divebatch_max_batch": 2048,
  "divebatch_lr_rescale": false,
  "divebatch_eps": 1e-12,
  "mlflow_experiment": "DiveBatch CIFAR10",
  "report_to": "mlflow"
}
