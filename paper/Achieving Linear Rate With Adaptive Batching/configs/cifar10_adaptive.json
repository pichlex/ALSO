  "mlflow_experiment": "Achieving Linear Rate - SGD Adaptive",
  "report_to": "mlflow",
  "tune_runs": 100,
  "n_epoches_tune": 10,
  "tune_name": "cifar10_sgd",
  "use_old_tune_params": true
}
