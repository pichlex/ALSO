  "epoch_start_ab": 2,
  "mlflow_experiment": "Achieving Linear Rate",
  "report_to": "mlflow",
  "tune_runs": 100,
  "n_epoches_tune": 5,
  "tune_name": "svhn_sgd",
  "use_old_tune_params": true
}
