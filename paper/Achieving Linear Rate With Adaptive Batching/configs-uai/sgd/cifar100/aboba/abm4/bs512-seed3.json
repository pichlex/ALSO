{
  "dataset": "cifar100",
  "model": "resnet34",
  "epochs": 40,
  "optimizer": "sgd",
  "lr": 0.005,
  "weight_decay": 0.005,
  "scheduler": "cosine",
  "scheduler_T_max": 40,
  "scheduler_eta_min": 0.0001,
  "augment": true,
  "adaptive_batch_min": 10,
  "adaptive_batch_max": 4096,
  "adaptive_batch_beta": 0.0,
  "report_to": "mlflow",
  "use_old_tune_params": false,
  "momentum": 0.9,
  "batch_size": 512,
  "seed": 3,
  "mlflow_experiment": "sgd-cifar100-aboba-bs512-seed3-abm4.0",
  "adaptive_batch": true,
  "adaptive_batch_strategy": "variance_ratio",
  "batch_size_multiplier": 4.0,
  "epoch_start_ab": 2
}
