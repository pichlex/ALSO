{
  "dataset": "cifar10",
  "model": "resnet18",
  "seed": 1,
  "augment": true,
  "batch_size": 64,
  "epochs": 200,
  "optimizer": "sgd",
  "lr": 0.01,
  "momentum": 0.9,
  "weight_decay": 0.0005,
  "scheduler": "cosine",
  "scheduler_T_max": 200,
  "scheduler_eta_min": 1e-06,
  "adaptive_batch": true,
  "adaptive_batch_strategy": "variance_ratio_iter",
  "adaptive_batch_beta": 0,
  "adaptive_batch_min": 8,
  "adaptive_batch_max": 4096,
  "batch_size_multiplier": 1.0,
  "epoch_start_ab": 1,
  "mlflow_experiment": "sgd-cifar10-aboba-bs64-seed1-abm1.0",
  "report_to": "mlflow",
  "tune_runs": 100,
  "n_epoches_tune": 10,
  "tune_name": "cifar10_sgd",
  "use_old_tune_params": false
}
